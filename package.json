{
  "name": "pointcloud-inspector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Professional browser-based point cloud inspection tool",
  "license": "GPL-3.0",
  "author": "FreshmanJ",
  "homepage": "https://www.gnu.org/licenses/gpl-3.0.html",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p worker/tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "cf:types": "wrangler types",
    "cf:deploy": "npm run build && wrangler deploy",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --target=node20 --outfile=.tmp/smoke.mjs --log-level=warning && node .tmp/smoke.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "laz-perf": "^0.0.7",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/node": "^26.4.1",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wrangler": "^4.129.0"
  }
}
